# Optional overrides for GPU-machine systemd. Copy to ~/.config/inglenook/env
# (mode 600). Defaults already point at the existing local processes.
#
# llama.cpp owns GGUF files on :8198. Do not put model paths here — inglenook
# must not start a second llama-server.
LLAMA_CPP_URL=http://127.0.0.1:8198
COMFY_URL=http://127.0.0.1:8188
VOICE_ENGINE_URL=http://127.0.0.1:8210
