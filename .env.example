# Copy to .env next to compose.yaml and fill in the GPU-server URLs.
# Never commit .env.

# ComfyUI HTTP origin on the GPU machine (not 127.0.0.1 of the NAS).
COMFYUI_URL=http://192.168.1.10:8188

# llama.cpp / llama-server OpenAI-compatible origin on the GPU machine.
LLAMA_CPP_URL=http://192.168.1.10:8198

# Published image. Use latest, or pin to a release tag such as 0.1.1.
INGLENOOK_IMAGE=ghcr.io/chaokingli/inglenook
INGLENOOK_VERSION=latest
INGLENOOK_PULL_POLICY=always

# Bind address and host ports on the NAS. Use a LAN IP instead of 0.0.0.0
# if you do not want the OpenAI and Comfy proxies on every interface.
INGLENOOK_BIND=0.0.0.0
INGLENOOK_CHAT_PORT=9292
INGLENOOK_IMAGE_PORT=9293

# comfy: read VRAM from ComfyUI /system_stats on the GPU server (NAS default).
# auto: nvidia-smi if present, otherwise ComfyUI. nvidia-smi: local GPU only.
INGLENOOK_VRAM_SOURCE=comfy

# llama-swap release tag (v250) or "latest". Used only when building locally.
LLAMA_SWAP_VERSION=latest
